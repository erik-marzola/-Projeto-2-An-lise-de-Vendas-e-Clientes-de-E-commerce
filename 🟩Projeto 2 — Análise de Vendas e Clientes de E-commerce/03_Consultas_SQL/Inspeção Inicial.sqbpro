FROM clientes

UNION ALL

SELECT 'pedidos', COUNT(*)
FROM pedidos

UNION ALL

SELECT 'itens_pedido', COUNT(*)
FROM itens_pedido

UNION ALL

SELECT 'produtos', COUNT(*)
FROM produtos;</sql><sql name="SELECT*">SELECT
    cliente_id,
    nome_cliente,
    cidade,
    estado
FROM clientes
LIMIT 10;</sql><current_tab id="2"/></tab_sql></sqlb_project>
